import { useFocusEffect } from "expo-router";
import { BarChart2, Calendar, TrendingUp, Users } from "lucide-react-native";
import React, { useState } from "react";
import { Dimensions, ScrollView, StyleSheet, Text, View } from "react-native";
import { SafeAreaView } from "react-native-safe-area-context";
import Svg, { Circle, G, Path, Line as SvgLine } from "react-native-svg";
import { ProgressBar } from "../../components/ProgressBar";
import { StatsCard } from "../../components/StatsCard";
import { useAuth } from "../../context/auth";
import {
  buildDeadlineBuckets,
  buildGroupStats,
  buildMemberStats,
  buildPriorityBreakdown,
  buildStatusDistribution,
  buildWeeklyTrend,
  buildWorkspaceOverview,
  formatLongDate,
  getAverageCycleDays,
  getDueSoonTasks,
  getUniqueMembers,
  getUpcomingTasks,
  DUE_SOON_DAYS,
  type GroupStat,
  type MemberStat,
} from "../../lib/stats";
import { loadTasks, subscribeToTasks, Task } from "../../lib/tasks";
import type { TeamMemberProfile, UserTeam } from "../../lib/teams";
import { getTeamMembers, getUserTeams } from "../../lib/teams";

const { width } = Dimensions.get("window");

/**
 * Compact metric tile used by the "Workspace Overview" card. Two of these fit
 * per row, which keeps the app-wide numbers together in one compact block.
 */
const MiniStat = ({
  label,
  value,
  hint,
}: {
  label: string;
  value: string | number;
  hint?: string;
}) => (
  <View style={styles.miniStat}>
    <Text style={styles.miniStatValue}>{value}</Text>
    <Text style={styles.miniStatLabel}>{label}</Text>
    {!!hint && <Text style={styles.miniStatHint}>{hint}</Text>}
  </View>
);

// Inline SVG Donut Chart
const SimpleDonutChart = ({
  data,
  radius = 75,
  strokeWidth = 22,
}: {
  data: any[];
  radius?: number;
  strokeWidth?: number;
}) => {
  const total = data.reduce((acc, curr) => acc + curr.value, 0);
  let accumulatedAngle = 0;

  if (total === 0) {
    return (
      <View style={styles.chartCenterContainer}>
        <Svg height={radius * 2} width={radius * 2}>
          <Circle
            cx={radius}
            cy={radius}
            r={radius - strokeWidth / 2}
            stroke="#E2E8F0"
            strokeWidth={strokeWidth}
            fill="transparent"
          />
        </Svg>
      </View>
    );
  }

  return (
    <View style={styles.chartCenterContainer}>
      <Svg
        height={radius * 2}
        width={radius * 2}
        viewBox={`0 0 ${radius * 2} ${radius * 2}`}
      >
        <G rotation="-90" origin={`${radius}, ${radius}`}>
          {data.map((item, index) => {
            if (item.value === 0) return null;
            const percentage = item.value / total;
            const strokeDasharray = 2 * Math.PI * (radius - strokeWidth / 2);
            const strokeDashoffset = strokeDasharray * (1 - percentage);
            const rotation = accumulatedAngle * 0;

            return (
              <Circle
                key={index}
                cx={radius}
                cy={radius}
                r={radius - strokeWidth / 2}
                stroke={item.color}
                strokeWidth={strokeWidth}
                strokeDasharray={strokeDasharray}
                strokeDashoffset={strokeDashoffset}
                fill="transparent"
                rotation={rotation}
                origin={`${radius}, ${radius}`}
                strokeLinecap="round"
              />
            );
          })}
        </G>
      </Svg>
    </View>
  );
};

// Inline SVG Line Chart
const SimpleLineChart = ({
  data,
  height = 180,
  width: chartWidth = width - 88,
}: {
  data: any[];
  height?: number;
  width?: number;
}) => {
  const maxValue = Math.max(...data.map((d) => d.value), 1);
  const paddingLeft = 20;
  const paddingBottom = 30;
  const paddingTop = 10;
  const innerWidth = chartWidth - paddingLeft;
  const innerHeight = height - paddingBottom - paddingTop;

  const points = data.map((d, index) => {
    const x = paddingLeft + (index / Math.max(data.length - 1, 1)) * innerWidth;
    const y = paddingTop + innerHeight - (d.value / maxValue) * innerHeight;
    return { x, y, ...d };
  });

  const pathD = points.reduce(
    (acc, point, index) =>
      index === 0
        ? `M ${point.x} ${point.y}`
        : `${acc} L ${point.x} ${point.y}`,
    "",
  );

  return (
    <View>
      <Svg width={chartWidth} height={height}>
        {[0, 0.5, 1].map((ratio, idx) => (
          <SvgLine
            key={idx}
            x1={paddingLeft}
            y1={paddingTop + innerHeight * ratio}
            x2={chartWidth}
            y2={paddingTop + innerHeight * ratio}
            stroke="#F1F5F9"
            strokeDasharray="4 4"
            strokeWidth="1"
          />
        ))}
        <Path d={pathD} fill="none" stroke="#4C51BF" strokeWidth="3" />
        {points.map((pt, idx) => (
          <G key={idx}>
            <Circle
              cx={pt.x}
              cy={pt.y}
              r="5"
              fill="#FFFFFF"
              stroke="#4C51BF"
              strokeWidth="2.5"
            />
          </G>
        ))}
      </Svg>
      <View style={styles.xAxisContainer}>
        {data.map((item, idx) => (
          <Text key={idx} style={styles.axisLabel}>
            {item.date}
          </Text>
        ))}
      </View>
    </View>
  );
};

export default function StatsScreen() {
  const { user } = useAuth();
  const [tasks, setTasks] = useState<Task[]>([]);
  const [groups, setGroups] = useState<UserTeam[]>([]);
  const [membersByTeamId, setMembersByTeamId] = useState<
    Record<string, TeamMemberProfile[]>
  >({});

  const userId = user?.id ?? null;

  // Tasks drive the throughput numbers (status mix, deadlines, success rate).
  const refreshTasks = React.useCallback(async () => {
    if (!userId) return;
    const { data, error } = await loadTasks(userId);
    if (!error) setTasks(data);
  }, [userId]);

  // Groups and their member directory come from the same sources the Team tab
  // uses, so the people numbers on this screen always match that tab.
  const refreshGroups = React.useCallback(async () => {
    if (!userId) return;

    try {
      const teams = await getUserTeams(userId);
      setGroups(teams);

      const entries = await Promise.all(
        teams.map(async (team) => {
          try {
            return [team.id, await getTeamMembers(team.id)] as const;
          } catch (err) {
            console.error("Error loading team members:", err);
            return [team.id, [] as TeamMemberProfile[]] as const;
          }
        }),
      );
      setMembersByTeamId(Object.fromEntries(entries));
    } catch (err) {
      console.error("Error loading teams:", err);
      setGroups([]);
      setMembersByTeamId({});
    }
  }, [userId]);

  React.useEffect(() => {
    if (!userId) return;

    // eslint-disable-next-line react-hooks/set-state-in-effect -- initial fetch + realtime subscription
    void refreshTasks();
    void refreshGroups();
    return subscribeToTasks(userId, () => void refreshTasks());
  }, [userId, refreshTasks, refreshGroups]);

  // Tabs stay mounted in the background, so re-read the whole workspace on every
  // focus: due dates, statuses and memberships edited on other tabs (Tasks,
  // Calendar, Team) are reflected here without a reload.
  useFocusEffect(
    React.useCallback(() => {
      void refreshTasks();
      void refreshGroups();
    }, [refreshTasks, refreshGroups]),
  );

  // The active group lives on the auth metadata (the same value the Team tab
  // switches), so the "ACTIVE" marker here matches that screen.
  const activeTeamId = user?.user_metadata?.teamId ?? null;

  // One pass over every area of the app: tasks (status, priority, deadlines,
  // subtasks), the Calendar side of those tasks (weekly buckets) and the Team
  // tab (groups + real member directory).
  const stats = React.useMemo(() => {
    const now = new Date();

    const groupStats = buildGroupStats(groups, membersByTeamId, activeTeamId);
    const members = getUniqueMembers(membersByTeamId);

    return {
      groupStats,
      members,
      memberStats: buildMemberStats(
        tasks,
        members,
        {
          id: user?.id,
          name: user?.user_metadata?.displayName ?? null,
          email: user?.email ?? null,
          role: groups.some((group) => group.role === "Owner")
            ? "Owner"
            : "Member",
        },
        now,
      ),
      overview: buildWorkspaceOverview(tasks, groupStats, members, now),
      statusDistribution: buildStatusDistribution(tasks),
      priorityBreakdown: buildPriorityBreakdown(tasks),
      trend: buildWeeklyTrend(tasks, 6, now),
      deadlines: buildDeadlineBuckets(tasks, now),
      dueSoon: getDueSoonTasks(tasks, DUE_SOON_DAYS, now).length,
      cycleDays: getAverageCycleDays(tasks),
      upcoming: getUpcomingTasks(tasks, 3),
    };
  }, [tasks, groups, membersByTeamId, user, activeTeamId]);

  return (
    <SafeAreaView style={styles.container}>
      <ScrollView
        style={styles.container}
        contentContainerStyle={styles.scrollContent}
        showsVerticalScrollIndicator={false}
      >
        <View style={styles.header}>
          <View style={styles.watermarkIcon}>
            <BarChart2 size={180} color="rgba(255, 255, 255, 0.08)" />
          </View>
          <View style={styles.headerContent}>
            <View style={styles.headerIconWrapper}>
              <TrendingUp size={22} color="#FFFFFF" />
            </View>
            <View>
              <Text style={styles.headerTitle}>Statistics</Text>
              <Text style={styles.headerSubtitle}>All areas · live data</Text>
            </View>
          </View>
        </View>

        {/* Headline numbers - identical maths to Home/Tasks (lib/stats) */}
        <View style={styles.metricsContainer}>
          <View style={styles.metricsGrid}>
            <StatsCard
              label="Completed"
              value={`${stats.overview.tasksDone}/${stats.overview.tasks}`}
            />
            <StatsCard
              label="Success Rate"
              value={`${stats.overview.completionRate}%`}
            />
            <StatsCard label="Overdue" value={stats.overview.overdue} />
          </View>
        </View>

        <View style={styles.cardsSection}>
          {/* Pulls Tasks, Calendar, groups and members into a single block */}
          <View style={styles.card}>
            <View style={styles.cardHeaderRow}>
              <View style={styles.cardHeaderCopy}>
                <Text style={styles.cardTitle}>Workspace Overview</Text>
                <Text style={styles.cardNote}>
                  TASKS · CALENDAR · GROUPS · MEMBERS
                </Text>
              </View>
              <Users size={18} color="#6366F1" />
            </View>

            <View style={styles.miniGrid}>
              <MiniStat label="GROUPS" value={stats.overview.groups} />
              <MiniStat
                label="MEMBERS"
                value={stats.overview.members}
                hint="ACROSS YOUR GROUPS"
              />
              <MiniStat label="OPEN TASKS" value={stats.overview.open} />
              <MiniStat
                label="DUE THIS WEEK"
                value={stats.overview.dueThisWeek}
              />
              <MiniStat
                label="DUE SOON"
                value={stats.dueSoon}
                hint={`WITHIN ${DUE_SOON_DAYS} DAYS`}
              />
              <MiniStat
                label="SUBTASKS DONE"
                value={`${stats.overview.subtasks.completed}/${stats.overview.subtasks.total}`}
                hint={`${stats.overview.subtasks.rate}% COMPLETE`}
              />
            </View>
          </View>

          {stats.overview.tasks === 0 && stats.overview.groups === 0 && (
            <View style={styles.card}>
              <Text style={styles.emptyCardText}>
                NOTHING TO MEASURE YET - CREATE A TASK OR A GROUP AND THE NUMBERS
                FILL IN AUTOMATICALLY
              </Text>
            </View>
          )}

          <View style={styles.card}>
            <View style={styles.cardHeaderRow}>
              <View style={styles.cardHeaderCopy}>
                <Text style={styles.cardTitle}>Task Distribution</Text>
                <Text style={styles.cardNote}>EVERY STATUS ON THE BOARD</Text>
              </View>
              <Text style={styles.cardMeta}>{stats.overview.tasks} TASKS</Text>
            </View>
            <SimpleDonutChart data={stats.statusDistribution} />
            <View style={styles.legendContainer}>
              {stats.statusDistribution.map((item, i) => (
                <View key={i} style={styles.legendItem}>
                  <View
                    style={[styles.legendDot, { backgroundColor: item.color }]}
                  />
                  <Text style={styles.legendText}>
                    {item.name}{" "}
                    <Text style={styles.legendCount}>{item.value}</Text>
                  </Text>
                </View>
              ))}
            </View>
          </View>

          <View style={styles.card}>
            <View style={styles.cardHeaderRow}>
              <View style={styles.cardHeaderCopy}>
                <Text style={styles.cardTitle}>Completion Trend</Text>
                <Text style={styles.cardNote}>
                  DONE TASKS BY DUE DATE · LAST 6 WEEKS
                </Text>
              </View>
              <Text style={styles.cardMeta}>
                {stats.cycleDays === null
                  ? "AVG. CYCLE -"
                  : `AVG. CYCLE ${stats.cycleDays}d`}
              </Text>
            </View>
            <SimpleLineChart data={stats.trend} />
          </View>

          {/* Calendar area: the same due dates the month grid reads */}
          <View style={styles.card}>
            <View style={styles.cardHeaderRow}>
              <View style={styles.cardHeaderCopy}>
                <Text style={styles.cardTitle}>Deadlines</Text>
                <Text style={styles.cardNote}>OPEN TASKS BY DUE WINDOW</Text>
              </View>
              <Calendar size={18} color="#6366F1" />
            </View>

            <View style={styles.deadlineGrid}>
              <View style={styles.deadlineChip}>
                <Text style={[styles.deadlineChipValue, { color: "#E11D48" }]}>
                  {stats.deadlines.overdue.length}
                </Text>
                <Text style={styles.deadlineChipLabel}>OVERDUE</Text>
              </View>
              <View style={styles.deadlineChip}>
                <Text style={[styles.deadlineChipValue, { color: "#D97706" }]}>
                  {stats.deadlines.today.length}
                </Text>
                <Text style={styles.deadlineChipLabel}>TODAY</Text>
              </View>
              <View style={styles.deadlineChip}>
                <Text style={[styles.deadlineChipValue, { color: "#4C51BF" }]}>
                  {stats.deadlines.thisWeek.length}
                </Text>
                <Text style={styles.deadlineChipLabel}>NEXT 7 DAYS</Text>
              </View>
              <View style={styles.deadlineChip}>
                <Text style={[styles.deadlineChipValue, { color: "#64748B" }]}>
                  {stats.deadlines.later.length}
                </Text>
                <Text style={styles.deadlineChipLabel}>LATER</Text>
              </View>
            </View>

            {stats.upcoming.length > 0 ? (
              <View style={styles.upcomingList}>
                {stats.upcoming.map((task) => (
                  <View key={task.id} style={styles.upcomingRow}>
                    <View style={styles.upcomingDot} />
                    <Text style={styles.upcomingTitle} numberOfLines={1}>
                      {task.title}
                    </Text>
                    <Text style={styles.upcomingDate}>
                      {formatLongDate(task.dueDate)}
                    </Text>
                  </View>
                ))}
              </View>
            ) : (
              <Text style={styles.emptyCardText}>NO UPCOMING DEADLINES</Text>
            )}
          </View>

          {/* Team area: real group members (falls back to task assignees) */}
          <View style={styles.card}>
            <View style={styles.cardHeaderRow}>
              <View style={styles.cardHeaderCopy}>
                <Text style={styles.cardTitle}>Member Proficiency</Text>
                <Text style={styles.cardNote}>
                  ASSIGNED WORK PER PERSON · ALL GROUPS
                </Text>
              </View>
              <Text style={styles.cardMeta}>
                {stats.memberStats.length} PEOPLE
              </Text>
            </View>
            {stats.memberStats.length === 0 ? (
              <Text style={styles.emptyCardText}>
                NO TASKS OR GROUP MEMBERS YET
              </Text>
            ) : (
              <View style={styles.membersList}>
                {stats.memberStats.slice(0, 6).map((member: MemberStat) => (
                  <View key={member.id} style={styles.memberRow}>
                    <View style={styles.memberHeader}>
                      <View style={styles.avatar}>
                        <Text style={styles.avatarText}>
                          {member.name.charAt(0).toUpperCase()}
                        </Text>
                      </View>
                      <View style={styles.memberInfo}>
                        <Text style={styles.memberName}>{member.name}</Text>
                        <Text style={styles.memberRole}>
                          {member.role}
                          {member.groupCount > 1
                            ? ` · ${member.groupCount} GROUPS`
                            : ""}
                          {member.overdue > 0
                            ? ` · ${member.overdue} OVERDUE`
                            : ""}
                        </Text>
                      </View>
                    </View>
                    <ProgressBar
                      value={member.rate}
                      label={
                        member.total === 0
                          ? "NO TASKS ASSIGNED"
                          : `${member.done}/${member.total} DONE`
                      }
                    />
                  </View>
                ))}
              </View>
            )}
          </View>

          <View style={styles.card}>
            <View style={styles.cardHeaderRow}>
              <View style={styles.cardHeaderCopy}>
                <Text style={styles.cardTitle}>Priority Breakdown</Text>
                <Text style={styles.cardNote}>ACROSS ALL TASKS</Text>
              </View>
              <Text style={styles.cardMeta}>
                {stats.overview.tasksDone} DONE
              </Text>
            </View>
            <SimpleDonutChart data={stats.priorityBreakdown} />
            <View style={styles.legendContainer}>
              {stats.priorityBreakdown.map((item, i) => (
                <View key={i} style={styles.legendItem}>
                  <View
                    style={[styles.legendDot, { backgroundColor: item.color }]}
                  />
                  <Text style={styles.legendText}>
                    {item.name}{" "}
                    <Text style={styles.legendCount}>{item.value}</Text>
                  </Text>
                </View>
              ))}
            </View>
          </View>

          {/* Team area: every group the user belongs to, with member totals */}
          <View style={styles.card}>
            <View style={styles.cardHeaderRow}>
              <View style={styles.cardHeaderCopy}>
                <Text style={styles.cardTitle}>Groups</Text>
                <Text style={styles.cardNote}>EVERY GROUP YOU BELONG TO</Text>
              </View>
              <Text style={styles.cardMeta}>
                {stats.groupStats.length} TOTAL
              </Text>
            </View>
            {stats.groupStats.length === 0 ? (
              <Text style={styles.emptyCardText}>
                YOU ARE NOT IN ANY GROUP YET
              </Text>
            ) : (
              <View style={styles.groupsList}>
                {stats.groupStats.map((group: GroupStat) => (
                  <View
                    key={group.id}
                    style={[
                      styles.groupRow,
                      group.isActive && styles.groupRowActive,
                    ]}
                  >
                    <View style={styles.groupAvatar}>
                      <Text style={styles.groupAvatarText}>
                        {group.name.charAt(0).toUpperCase()}
                      </Text>
                    </View>
                    <View style={styles.groupInfo}>
                      <Text style={styles.groupName} numberOfLines={1}>
                        {group.name}
                      </Text>
                      <Text style={styles.groupMeta}>
                        {group.memberCount}{" "}
                        {group.memberCount === 1 ? "MEMBER" : "MEMBERS"}
                        {group.createdAt
                          ? ` · SINCE ${formatLongDate(group.createdAt)}`
                          : ""}
                      </Text>
                    </View>
                    <View
                      style={[
                        styles.groupRoleBadge,
                        group.isActive && styles.groupRoleBadgeActive,
                      ]}
                    >
                      <Text
                        style={[
                          styles.groupRoleText,
                          group.isActive && styles.groupRoleTextActive,
                        ]}
                      >
                        {group.isActive ? "ACTIVE" : group.role.toUpperCase()}
                      </Text>
                    </View>
                  </View>
                ))}
              </View>
            )}
          </View>
        </View>
      </ScrollView>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: "#F7F9FC" },
  scrollContent: { paddingBottom: 120 },
  // Matches the home screen header metrics (20/20/50 padding + 44px content) so
  // the Statistics header has the same height as the HOME header.
  header: {
    backgroundColor: "#0F172A",
    paddingHorizontal: 20,
    paddingTop: 20,
    paddingBottom: 50,
    position: "relative",
    overflow: "hidden",
  },
  watermarkIcon: { position: "absolute", right: -20, top: -20 },
  headerContent: {
    flexDirection: "row",
    alignItems: "center",
    gap: 16,
    zIndex: 10,
  },
  headerIconWrapper: {
    width: 44,
    height: 44,
    borderRadius: 14,
    backgroundColor: "rgba(255, 255, 255, 0.1)",
    alignItems: "center",
    justifyContent: "center",
  },
  headerTitle: {
    fontSize: 22,
    fontWeight: "900",
    color: "#FFFFFF",
    textTransform: "uppercase",
  },
  headerSubtitle: {
    fontSize: 10,
    fontWeight: "900",
    color: "rgba(255, 255, 255, 0.7)",
    textTransform: "uppercase",
    letterSpacing: 1.5,
    marginTop: 2,
  },
  metricsContainer: {
    paddingHorizontal: 20,
    // Matches home's card overlap (-30) now that the header shares its 50px
    // bottom padding, keeping the same tight header/card composition.
    marginTop: -30,
    zIndex: 20,
    marginBottom: 24,
  },
  metricsGrid: { flexDirection: "row", gap: 10 },
  cardsSection: { paddingHorizontal: 20, gap: 20 },
  card: {
    backgroundColor: "#FFFFFF",
    padding: 20,
    borderRadius: 24,
    borderWidth: 1,
    borderColor: "#F1F5F9",
  },
  cardHeaderRow: {
    flexDirection: "row",
    justifyContent: "space-between",
    alignItems: "flex-start",
    gap: 10,
    marginBottom: 18,
  },
  cardHeaderCopy: { flex: 1 },
  cardTitle: {
    fontSize: 14,
    fontWeight: "700",
    color: "#1E293B",
  },
  cardNote: {
    fontSize: 9,
    fontWeight: "700",
    color: "#94A3B8",
    letterSpacing: 0.8,
    marginTop: 3,
  },
  cardMeta: {
    fontSize: 9,
    fontWeight: "800",
    color: "#6366F1",
    letterSpacing: 0.8,
    marginTop: 3,
  },
  chartCenterContainer: {
    alignItems: "center",
    justifyContent: "center",
    marginVertical: 8,
  },
  legendContainer: {
    flexDirection: "row",
    flexWrap: "wrap",
    justifyContent: "center",
    gap: 16,
    marginTop: 20,
  },
  legendItem: { flexDirection: "row", alignItems: "center", gap: 6 },
  legendDot: { width: 10, height: 10, borderRadius: 5 },
  legendText: { fontSize: 11, fontWeight: "500", color: "#64748B" },
  legendCount: { fontWeight: "700", color: "#0F172A" },
  xAxisContainer: {
    flexDirection: "row",
    justifyContent: "space-between",
    paddingLeft: 20,
    marginTop: 8,
  },
  axisLabel: { fontSize: 10, color: "#94A3B8", fontWeight: "500" },
  membersList: { gap: 18 },
  memberRow: { gap: 8 },
  memberHeader: { flexDirection: "row", alignItems: "center", gap: 10 },
  avatar: {
    width: 32,
    height: 32,
    borderRadius: 8,
    backgroundColor: "#4C51BF",
    alignItems: "center",
    justifyContent: "center",
  },
  avatarText: { color: "#FFFFFF", fontSize: 11, fontWeight: "900" },
  memberInfo: { flex: 1 },
  memberName: {
    fontSize: 12,
    fontWeight: "900",
    color: "#1E293B",
    textTransform: "uppercase",
  },
  memberRole: {
    fontSize: 9,
    fontWeight: "700",
    color: "#94A3B8",
    textTransform: "uppercase",
    letterSpacing: 0.8,
  },
  miniGrid: {
    flexDirection: "row",
    flexWrap: "wrap",
    gap: 10,
  },
  miniStat: {
    flexGrow: 1,
    flexBasis: "47%",
    backgroundColor: "#F8FAFC",
    borderRadius: 16,
    borderWidth: 1,
    borderColor: "#F1F5F9",
    paddingVertical: 12,
    paddingHorizontal: 12,
  },
  miniStatValue: { fontSize: 18, fontWeight: "900", color: "#0F172A" },
  miniStatLabel: {
    fontSize: 9,
    fontWeight: "800",
    color: "#94A3B8",
    letterSpacing: 0.8,
    marginTop: 2,
  },
  miniStatHint: {
    fontSize: 8,
    fontWeight: "700",
    color: "#A5ADBA",
    letterSpacing: 0.6,
    marginTop: 3,
  },
  deadlineGrid: {
    flexDirection: "row",
    flexWrap: "wrap",
    gap: 10,
    marginBottom: 16,
